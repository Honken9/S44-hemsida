---
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Hem" },
  { href: "/lagenheter", label: "Lägenheter" },
  { href: "/kontakt", label: "Kontakt" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="border-b border-line bg-bone/80 backdrop-blur sticky top-0 z-30">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-baseline gap-2 group">
      <span class="font-serif text-xl tracking-tight text-ink group-hover:text-accent transition-colors">
        Skatelövsvägen 44
      </span>
      <span class="hidden text-xs uppercase tracking-[0.2em] text-stone sm:inline">
        Grimslöv
      </span>
    </a>
    <nav>
      <ul class="flex items-center gap-7 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "transition-colors hover:text-accent",
                  isActive(link.href) ? "text-ink" : "text-stone",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
