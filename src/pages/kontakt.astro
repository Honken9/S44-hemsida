---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
  title="Kontakt – Skatelövsvägen 44"
  description="Kontakta oss om lägenheterna på Skatelövsvägen 44 i Grimslöv."
>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8 sm:px-6 sm:pt-20 sm:pb-10">
    <p class="text-xs uppercase tracking-[0.3em] text-stone">Kontakt</p>
    <h1 class="mt-3 font-serif text-3xl text-ink sm:text-5xl">
      Hör av dig
    </h1>
    <p class="mt-5 max-w-2xl text-stone leading-relaxed sm:mt-6">
      Fyll i formuläret nedan så återkommer vi så snart vi kan. Vill du hellre
      mejla direkt går det också bra till
      <a
        class="break-words underline underline-offset-4 hover:text-accent"
        href={`mailto:${site.contactEmail}`}
      >
        {site.contactEmail}
      </a>.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 pb-16 sm:px-6 sm:pb-24 lg:grid-cols-[2fr_1fr] lg:gap-16">
    <form
      id="contact-form"
      class="space-y-5 rounded-lg border border-line bg-white/50 p-6 sm:space-y-6 sm:p-10"
      novalidate
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium text-ink">Namn *</span>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-md border border-line bg-bone px-4 py-3 text-ink outline-none transition focus:border-accent"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink">E-post *</span>
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-md border border-line bg-bone px-4 py-3 text-ink outline-none transition focus:border-accent"
          />
        </label>
      </div>

      <label class="block">
        <span class="text-sm font-medium text-ink">Telefon</span>
        <input
          name="phone"
          type="tel"
          autocomplete="tel"
          class="mt-2 w-full rounded-md border border-line bg-bone px-4 py-3 text-ink outline-none transition focus:border-accent"
        />
      </label>

      <label class="block">
        <span class="text-sm font-medium text-ink">Meddelande *</span>
        <textarea
          name="message"
          rows="6"
          required
          class="mt-2 w-full resize-y rounded-md border border-line bg-bone px-4 py-3 text-ink outline-none transition focus:border-accent"
        ></textarea>
      </label>

      <input
        type="text"
        name="company"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
        <p
          id="contact-status"
          class="text-sm text-stone"
          role="status"
          aria-live="polite"
        ></p>
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-bone transition hover:bg-ink disabled:opacity-60 sm:w-auto"
        >
          <span data-label>Skicka</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </form>

    <aside class="space-y-8">
      <figure class="overflow-hidden rounded-xl">
        <img
          src="/fastighet-uteplats.jpg"
          alt="Uteplats vid fastigheten på Skatelövsvägen 44"
          loading="lazy"
          class="h-auto w-full object-cover"
        />
      </figure>
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-stone">Adress</p>
        <p class="mt-2 text-ink">{site.street}</p>
        <p class="text-ink">{site.postalCode} {site.city}</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-stone">E-post</p>
        <a
          class="mt-2 block break-words text-ink hover:text-accent"
          href={`mailto:${site.contactEmail}`}
        >
          {site.contactEmail}
        </a>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-stone">Visning</p>
        <p class="mt-2 text-stone leading-relaxed">
          Visningar bokas vid intresse — skriv gärna i meddelandet vilken
          lägenhet och tid som passar dig.
        </p>
      </div>
    </aside>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  if (form && status) {
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const label = button.querySelector("[data-label]") as HTMLElement;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = "";
      status.className = "text-sm text-stone";
      button.disabled = true;
      label.textContent = "Skickar…";

      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && json.ok) {
          form.reset();
          status.textContent = "Tack! Vi återkommer så snart vi kan.";
          status.className = "text-sm text-accent";
        } else {
          status.textContent =
            json.error ?? "Något gick fel. Försök igen om en stund.";
          status.className = "text-sm text-red-700";
        }
      } catch {
        status.textContent = "Något gick fel. Försök igen om en stund.";
        status.className = "text-sm text-red-700";
      } finally {
        button.disabled = false;
        label.textContent = "Skicka";
      }
    });
  }
</script>
