---
import Layout from "../layouts/Layout.astro";
import { apartments, apartmentPlaceholderImage } from "../data/site";

const statusStyle: Record<string, string> = {
  Ledig: "bg-accent text-bone",
  Uthyrd: "bg-line text-stone",
  Kö: "bg-ink/90 text-bone",
};
---

<Layout
  title="Lägenheter – Skatelövsvägen 44"
  description="Åtta tvåor på Skatelövsvägen 44 i Grimslöv, fördelade på två plan."
>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8 sm:px-6 sm:pt-20 sm:pb-10">
    <p class="text-xs uppercase tracking-[0.3em] text-stone">Lägenheter</p>
    <h1 class="mt-3 font-serif text-3xl text-ink sm:text-5xl">
      Åtta hem under samma tak
    </h1>
    <p class="mt-5 max-w-2xl text-stone leading-relaxed sm:mt-6">
      Här hittar du översikt över samtliga lägenheter på Skatelövsvägen 44.
      Status uppdateras löpande — för mer detaljerad information, visning eller
      köanmälan, hör av dig via kontaktsidan.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-6 sm:pb-24">
    <div
      class="mb-8 flex items-start gap-3 rounded-md border border-line bg-white/60 p-4 text-sm text-stone sm:mb-10 sm:p-5"
      role="note"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="mt-0.5 h-5 w-5 flex-none text-accent"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M12 8v4" stroke-linecap="round" />
        <circle cx="12" cy="16" r="0.5" fill="currentColor" />
      </svg>
      <p>
        <span class="font-medium text-ink">Bilderna är illustrativa</span> och
        visar inte de specifika lägenheterna på Skatelövsvägen 44. Hör av dig
        för aktuella foton, planlösning eller bokad visning.
      </p>
    </div>

    <ul class="grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {
        apartments.map((apt) => (
          <li class="group flex flex-col overflow-hidden rounded-lg border border-line bg-white/40 transition hover:bg-white">
            <div class="relative aspect-[4/3] overflow-hidden bg-line">
              <img
                src={apt.image ?? apartmentPlaceholderImage}
                alt={`Illustrativ bild för ${apt.name}`}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              {
                !apt.image && (
                  <span class="absolute left-3 top-3 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] uppercase tracking-[0.18em] text-bone backdrop-blur-sm">
                    Illustration
                  </span>
                )
              }
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center justify-between">
                <h2 class="font-serif text-xl text-ink">{apt.name}</h2>
                <span
                  class:list={[
                    "rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.18em]",
                    statusStyle[apt.status],
                  ]}
                >
                  {apt.status}
                </span>
              </div>
              {apt.description && (
                <p class="mt-3 text-sm text-stone">{apt.description}</p>
              )}
              <dl class="mt-6 grid grid-cols-2 gap-y-2 gap-x-4 border-t border-line pt-5 text-sm">
                <dt class="text-stone">Rum</dt>
                <dd class="text-right text-ink">{apt.rooms}</dd>
                <dt class="text-stone">Plan</dt>
                <dd class="text-right text-ink">{apt.floor}</dd>
                {apt.size && (
                  <>
                    <dt class="text-stone">Storlek</dt>
                    <dd class="text-right text-ink">{apt.size}</dd>
                  </>
                )}
                {apt.rent && (
                  <>
                    <dt class="text-stone">Hyra</dt>
                    <dd class="text-right text-ink">{apt.rent}</dd>
                  </>
                )}
              </dl>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 rounded-lg border border-line bg-white/40 p-6 text-center sm:mt-16 sm:p-12">
      <p class="text-xs uppercase tracking-[0.3em] text-stone">Intresserad?</p>
      <h2 class="mt-3 font-serif text-xl text-ink sm:text-3xl">
        Hör av dig för visning eller köanmälan
      </h2>
      <a
        href="/kontakt"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-bone transition hover:bg-ink"
      >
        Kontakta oss
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
