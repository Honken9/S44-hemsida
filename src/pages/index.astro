---
import Layout from "../layouts/Layout.astro";
import { heroImage, apartments } from "../data/site";

const ledigaCount = apartments.filter((a) => a.status === "Ledig").length;
---

<Layout>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src={heroImage}
        alt="Skatelövsvägen 44, Grimslöv"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-bone"></div>
    </div>
    <div class="mx-auto max-w-6xl px-5 pt-24 pb-28 text-bone sm:px-6 sm:pt-32 sm:pb-40">
      <p class="text-[11px] uppercase tracking-[0.3em] text-bone/80 sm:text-xs">
        Bostäder · Grimslöv
      </p>
      <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-6xl lg:text-7xl">
        Skatelövsvägen 44
      </h1>
      <p class="mt-5 max-w-xl text-base text-bone/90 sm:mt-6 sm:text-lg">
        Åtta lägenheter i en lugn miljö några minuter från sjön Åsnen. En plats
        att kalla hemma — året runt.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 sm:mt-10 sm:gap-4">
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 rounded-full bg-bone px-5 py-3 text-sm font-medium text-ink transition hover:bg-white sm:px-6"
        >
          Kontakta oss
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-6 sm:py-24">
    <div class="max-w-2xl text-stone leading-relaxed">
      <p>
        Fastigheten på Skatelövsvägen 44 i Grimslöv rymmer åtta lägenheter
        fördelade på två plan, alla lägenheter är tvåor på 64 till 75
        kvadratmeter. Här bor du nära vardagsservicen i byn — pizzerian,
        ICA-affären, banken och skola/förskola. Det är cirka 20 minuter
        bilfärd in till Växjö.
      </p>
        {
          ledigaCount > 0 ? (
            <p class="mt-4">
              Just nu finns
              <span class="font-medium text-ink">
                {ledigaCount === 1
                  ? "1 ledig lägenhet"
                  : `${ledigaCount} lediga lägenheter`}
              </span>
              — kontakta oss för mer information eller en visning.
            </p>
          ) : (
            <p class="mt-4">
              Just nu är samtliga lägenheter uthyrda. Hör gärna av dig om du
              vill ställa dig i kö för framtida visningar.
            </p>
          )
        }
    </div>

    <figure class="mt-12 overflow-hidden rounded-xl sm:mt-16">
      <img
        src="/fastighet-langsida.jpg"
        alt="Fastigheten på Skatelövsvägen 44 sedd från trädgårdssidan med balkonger och uteplats"
        loading="lazy"
        class="h-auto w-full object-cover"
      />
    </figure>

    <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-line pt-8 sm:mt-16 sm:gap-8 sm:pt-10 sm:grid-cols-4">
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Lägenheter</dt>
        <dd class="mt-2 font-serif text-2xl text-ink sm:text-3xl">8</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Plan</dt>
        <dd class="mt-2 font-serif text-2xl text-ink sm:text-3xl">2</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Storlek</dt>
        <dd class="mt-2 font-serif text-2xl text-ink sm:text-3xl">2 rok</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Ort</dt>
        <dd class="mt-2 font-serif text-2xl text-ink sm:text-3xl">Grimslöv</dd>
      </div>
    </dl>
  </section>
</Layout>
