---
import Layout from "../layouts/Layout.astro";
import { heroImage, apartments } from "../data/site";

const ledigaCount = apartments.filter((a) => a.status === "Ledig").length;
---

<Layout>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src={heroImage}
        alt="Skatelövsvägen 44, Grimslöv"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-bone"></div>
    </div>
    <div class="mx-auto max-w-6xl px-6 pt-32 pb-40 text-bone">
      <p class="text-xs uppercase tracking-[0.3em] text-bone/80">
        Bostäder · Grimslöv
      </p>
      <h1 class="mt-4 font-serif text-5xl leading-tight sm:text-7xl">
        Skatelövsvägen 44
      </h1>
      <p class="mt-6 max-w-xl text-lg text-bone/90">
        Åtta lägenheter i en lugn miljö några minuter från sjön Åsnen. En plats
        att kalla hemma — året runt.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/lagenheter"
          class="inline-flex items-center gap-2 rounded-full bg-bone px-6 py-3 text-sm font-medium text-ink transition hover:bg-white"
        >
          Se lägenheterna
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 rounded-full border border-bone/60 px-6 py-3 text-sm font-medium text-bone transition hover:bg-bone/10"
        >
          Kontakta oss
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-12 sm:grid-cols-2">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-stone">
          Om fastigheten
        </p>
        <h2 class="mt-3 font-serif text-3xl text-ink sm:text-4xl">
          En byggnad med plats för åtta hem
        </h2>
      </div>
      <div class="text-stone leading-relaxed">
        <p>
          Fastigheten på Skatelövsvägen 44 i Grimslöv rymmer åtta lägenheter
          fördelade på två plan, alla lägenheter är tvåor. Här bor du nära
          skogen, sjön och vardagsservicen i samhället.
        </p>
        <p class="mt-4">
          Just nu finns
          <span class="font-medium text-ink">{ledigaCount} lediga lägenheter</span>
          — kontakta oss för mer information eller en visning.
        </p>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-8 border-t border-line pt-10 sm:grid-cols-4">
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Lägenheter</dt>
        <dd class="mt-2 font-serif text-3xl text-ink">8</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Plan</dt>
        <dd class="mt-2 font-serif text-3xl text-ink">2</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Storlek</dt>
        <dd class="mt-2 font-serif text-3xl text-ink">2 rok</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.2em] text-stone">Ort</dt>
        <dd class="mt-2 font-serif text-3xl text-ink">Grimslöv</dd>
      </div>
    </dl>
  </section>
</Layout>
